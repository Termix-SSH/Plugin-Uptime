      }
    },
    "GET /plugin-api/uptime/permissions": {
      "access": "user",
      "permission": "uptime.view"
    },
    "GET /plugin-api/uptime/push/:token": {
      "access": "public"
    },
    "POST /plugin-api/uptime/push/:token": {
      "access": "public"
    },
    "GET /plugin-api/uptime/share-targets": {
      "access": "user",
      "permission": "uptime.view"
    },
    "GET /plugin-api/uptime/status/:slug": {
      "access": "public"
    },
    "GET /plugin-api/uptime/status/:slug/data": {
