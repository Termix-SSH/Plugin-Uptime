      }
    },
    "DELETE /plugin-api/uptime/pages/:id/notes/:noteId": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "uptime.pages"
      },
      "params": {
        "id": "uptime.pages"
      },
      "destructive": true
    },
    "POST /plugin-api/uptime/pages/:id/notes/:noteId": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "uptime.pages"
      },
      "params": {
