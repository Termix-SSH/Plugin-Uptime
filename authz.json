        "kind": "own",
        "fixture": "uptime.monitors"
      },
      "params": {
        "id": "uptime.monitors"
      }
    },
    "POST /plugin-api/uptime/monitors/:id/push-url": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "uptime.monitors"
      },
      "params": {
        "id": "uptime.monitors"
      }
    },
    "POST /plugin-api/uptime/monitors/:id/run": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "uptime.monitors"
      },
      "params": {
        "id": "uptime.monitors"
      },
      "destructive": true
    },
    "GET /plugin-api/uptime/monitors/:id/shares": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "uptime.monitors"
      },
      "params": {
        "id": "uptime.monitors"
      }
    },
    "PUT /plugin-api/uptime/monitors/:id/shares": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "uptime.monitors"
      },
      "params": {
        "id": "uptime.monitors"
      }
    },
    "POST /plugin-api/uptime/monitors/:id/watch": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "uptime.monitors"
      },
      "params": {
        "id": "uptime.monitors"
      }
    },
    "POST /plugin-api/uptime/monitors/hosts": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "connect",
        "key": "hostId"
      },
      "filtered": true,
      "note": "Adds monitors only for hosts the caller may see"
    },
    "POST /plugin-api/uptime/monitors/test": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "connect",
        "key": "hostId"
      },
      "body": {
        "name": "authz-x",
        "type": "http",
        "config": {
          "url": "http://203.0.113.9/"
        }
      }
    },
    "GET /plugin-api/uptime/pages": {
      "access": "user",
      "permission": ["uptime.view", "uptime.publish"]
    },
    "POST /plugin-api/uptime/pages": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "connect",
        "key": "hostId"
      }
    },
    "DELETE /plugin-api/uptime/pages/:id": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "uptime.pages"
      },
      "params": {
        "id": "uptime.pages"
      },
      "destructive": true
    },
    "PUT /plugin-api/uptime/pages/:id": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "uptime.pages"
      },
      "params": {
